{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "avatar.schema.json",
  "title": "AvatarSpec",
  "description": "A Mii-style donor avatar. Parametric only: never store photos or photo-derived images here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "consent", "head", "hair", "eyes", "eyebrows", "nose", "mouth", "glasses", "facialHair", "shirtColor", "height"],
  "definitions": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "maxLength": 40 },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "givenOn"],
      "properties": {
        "public": { "const": true },
        "givenOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "skinTone"],
      "properties": {
        "shape": { "enum": ["round", "oval", "square", "long", "heart"] },
        "skinTone": { "$ref": "#/definitions/color" }
      }
    },
    "hair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "color"],
      "properties": {
        "style": { "enum": ["none", "buzz", "short", "sidepart", "curly", "afro", "long", "ponytail", "bun"] },
        "color": { "$ref": "#/definitions/color" }
      }
    },
    "eyes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "color"],
      "properties": {
        "style": { "enum": ["round", "almond", "narrow", "wide", "sleepy"] },
        "color": { "$ref": "#/definitions/color" }
      }
    },
    "eyebrows": { "enum": ["straight", "arched", "thick", "thin"] },
    "nose": { "enum": ["small", "button", "long", "wide"] },
    "mouth": { "enum": ["smile", "neutral", "grin", "small"] },
    "glasses": { "enum": ["none", "round", "square", "sunglasses"] },
    "facialHair": { "enum": ["none", "stubble", "mustache", "beard"] },
    "shirtColor": { "$ref": "#/definitions/color" },
    "height": { "type": "number", "minimum": 0.8, "maximum": 1.2 }
  }
}
